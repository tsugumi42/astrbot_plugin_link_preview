{
  "common": {
    "description": "通用",
    "type": "object",
    "items": {
      "max_links_per_message": {
        "description": "单次链接数",
        "type": "int",
        "default": 1
      },
      "cooldown_seconds": {
        "description": "冷却秒数",
        "type": "int",
        "default": 10
      },
      "request_timeout_seconds": {
        "description": "请求超时",
        "type": "int",
        "default": 10
      },
      "send_processing_status": {
        "description": "处理提示",
        "type": "bool",
        "hint": "收到链接后先回应。群聊优先表情，私聊用文字。",
        "default": true
      },
      "image_position": {
        "description": "图片位置",
        "type": "string",
        "options": ["before_text", "after_text"],
        "hint": "before_text=先图后文，after_text=先文后图。",
        "default": "before_text"
      }
    }
  },
  "access": {
    "description": "权限",
    "type": "object",
    "items": {
      "group_mode": {
        "description": "群聊权限",
        "type": "string",
        "options": ["all", "whitelist", "blacklist", "private_only"],
        "hint": "all=全部群，whitelist=只允许名单群，blacklist=屏蔽名单群，private_only=仅私聊。",
        "default": "all"
      },
      "group_ids": {
        "description": "群号名单",
        "type": "string",
        "hint": "群号用逗号、空格或换行分隔。",
        "default": ""
      },
      "private_mode": {
        "description": "私聊权限",
        "type": "string",
        "options": ["all", "friends", "whitelist", "blacklist", "none"],
        "hint": "all=所有私聊，friends=仅好友，whitelist=只允许白名单，blacklist=屏蔽黑名单，none=拒绝私聊。",
        "default": "all"
      },
      "private_whitelist": {
        "description": "私聊白名单",
        "type": "string",
        "hint": "QQ号用逗号、空格或换行分隔。命中白名单优先允许。",
        "default": ""
      },
      "private_blacklist": {
        "description": "私聊黑名单",
        "type": "string",
        "hint": "QQ号用逗号、空格或换行分隔。命中黑名单优先拒绝。",
        "default": ""
      }
    }
  },
  "youtube": {
    "description": "YouTube",
    "type": "object",
    "items": {
      "enable_youtube": {
        "description": "启用预览",
        "type": "bool",
        "default": true
      },
      "send_thumbnail_image": {
        "description": "发送缩略图",
        "type": "bool",
        "default": true
      },
      "youtube_fetch_page_details": {
        "description": "补充数据",
        "type": "bool",
        "hint": "尝试读取播放量、点赞量、上传日期。失败时仍返回基础预览。",
        "default": true
      },
      "youtube_detail_timeout_seconds": {
        "description": "补充超时",
        "type": "int",
        "default": 4
      },
      "youtube_fields": {
        "description": "显示内容",
        "type": "list",
        "options": ["title", "author", "metrics", "description", "url"],
        "hint": "title=标题，author=频道，metrics=播放/点赞/日期，description=简介，url=链接。",
        "default": ["title", "author", "metrics", "url"]
      }
    }
  },
  "twitter": {
    "description": "Twitter/X",
    "type": "object",
    "items": {
      "enable_twitter": {
        "description": "启用预览",
        "type": "bool",
        "default": true
      },
      "send_twitter_images": {
        "description": "发送图片",
        "type": "bool",
        "default": true
      },
      "twitter_fields": {
        "description": "显示内容",
        "type": "list",
        "options": ["url", "published_at", "metrics", "author", "description"],
        "hint": "url=链接，published_at=时间(+8)，metrics=互动数，author=作者，description=正文。",
        "default": ["url", "published_at", "metrics", "author", "description"]
      }
    }
  },
  "api": {
    "description": "API预留",
    "type": "object",
    "items": {
      "youtube_api_key": {
        "description": "YouTube Key",
        "type": "string",
        "default": ""
      },
      "twitter_bearer_token": {
        "description": "Twitter Token",
        "type": "string",
        "default": ""
      }
    }
  }
}
